# Port for the HTTP + Socket.IO server (Render sets this automatically)
PORT=3001

# Comma-separated frontend URLs allowed by CORS
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Groq free-tier key for Most-stats AI commentary. Never put this in frontend code.
# Get one at https://console.groq.com/keys
GROQ_API_KEY=
# Optional. A free-tier model id.
GROQ_MODEL=llama-3.3-70b-versatile
